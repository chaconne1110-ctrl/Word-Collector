// CURRENT analysis server for V11.21 and later, the six evaluation apps and /v3/
// (word-collector-api-v3 + D1 word-collector-db-v3, copied from the Friday 2026-11-20 database).
// Deploy:  npx wrangler@4 deploy -c cloudflare/deploy/wrangler.v3.jsonc --keep-vars
// Secrets (set once per Worker, never commit):
//   npx wrangler@4 secret put GEMINI_API_KEY      -c cloudflare/deploy/wrangler.v3.jsonc
//   npx wrangler@4 secret put GEMINI_RELAY_SECRET -c cloudflare/deploy/wrangler.v3.jsonc   (= Cloud Run env RELAY_SECRET)
{
  "name": "word-collector-api-v3",
  "main": "../worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "placement": { "region": "gcp:us-central1" },
  "vars": { "ENABLE_LIVE_ANALYSIS": "true", "ENABLE_IMAGE_GENERATION": "true", "GEMINI_RELAY_URL": "https://word-collector-gemini-relay-557058448320.us-central1.run.app" },
  "d1_databases": [{ "binding": "DB", "database_name": "word-collector-db-v3", "database_id": "ce2461df-6e07-4f1d-be50-2bbbaf0cd715" }]
}
