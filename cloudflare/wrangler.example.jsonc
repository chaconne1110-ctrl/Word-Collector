{
  "name": "word-collector-api",
  "main": "worker.mjs",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  "vars": { "ENABLE_LIVE_ANALYSIS": "true" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "REPLACE_WITH_EXISTING_DATABASE_NAME",
    "database_id": "REPLACE_WITH_EXISTING_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
