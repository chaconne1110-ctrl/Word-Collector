{
  // Copy to a local file and fill in your existing D1 database ID.
  // Do not commit real API keys, tokens, or payment details.
  "name": "word-collector-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "word-collector-db",
      "database_id": "REPLACE_WITH_YOUR_EXISTING_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "ENABLE_LIVE_ANALYSIS": "true",
    "ENABLE_IMAGE_GENERATION": "true"
  }
}
