# Keep LF on checkout on every OS (the repo stores LF; some tests match source text with \n).
* text=auto eol=lf
# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.jar binary
*.keystore binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.wasm binary
*.gz binary
*.bcmap binary
*.pfb binary
*.icc binary
